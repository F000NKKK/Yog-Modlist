<?xml version="1.0" encoding="utf-8"?>
<!-- The mod browser. Code-behind: mod_list.rs (rows of the list are added there at runtime). -->
<Screen id="yog-modlist:mod_list"
        width="400"
        height="252"
        anchor="center"
        bg="#E0101010">
    <!-- Screen children are placed at x/y; this one fills it and stacks the rest. -->
    <Column w="100%"
            h="100%"
            gap="0">
        <Row id="header"
             w="100%"
             h="20"
             padding="0 8"
             align="center"
             bg="#FF222222">
            <Label id="title"
                   text="@Strings.screen.title"
                   color="#FFD700"
                   no_wrap="true" />
            <Spacer flex="1" />
            <Label id="mod_count"
                   text="0 mods"
                   color="#AAAAAA"
                   shadow="false"
                   no_wrap="true" />
        </Row>
        <!-- Below the header: the list on the left half, details filling the rest. -->
        <Row flex="1"
             w="100%"
             padding="6 8 4 8"
             gap="6">
            <Column w="50%"
                    h="100%"
                    gap="4">
                <TextBox id="search"
                         w="100%"
                         h="16"
                         placeholder="@Strings.search.placeholder"
                         max_length="64"
                         on_change="search" />
                <Row id="filters"
                     w="100%"
                     h="14"
                     gap="3">
                    <Button id="filter_all"
                            w="58"
                            h="14"
                            text="@Strings.filter.all"
                            bg="#FF555555"
                            color="#FFFFFF"
                            on_click="filter_all" />
                    <Button id="filter_yog"
                            w="58"
                            h="14"
                            text="@Strings.filter.yog"
                            bg="#FF333333"
                            color="#FFFFFF"
                            on_click="filter_yog" />
                    <Button id="filter_platform"
                            w="58"
                            h="14"
                            text="@Strings.filter.platform"
                            bg="#FF333333"
                            color="#FFFFFF"
                            on_click="filter_platform" />
                </Row>
                <ScrollView id="mod_list"
                            w="100%"
                            flex="1"
                            gap="2"
                            padding="2"
                            bg="#88111111" />
            </Column>
            <ScrollView id="details"
                        flex="1"
                        h="100%"
                        gap="3"
                        padding="4 6"
                        bg="#88111111">
                <Label id="detail_name" text="Mod Name" color="#FFFFFF" />
                <Label id="detail_version"
                       text="v1.0.0"
                       color="#AAAAAA"
                       shadow="false" />
                <Label id="detail_source"
                       text="Yog mod"
                       color="#88FF88"
                       shadow="false" />
                <Label id="detail_authors"
                       text="by Author"
                       color="#CCCCCC"
                       shadow="false" />
                <Label id="detail_id"
                       text="id: mod_id"
                       color="#9999BB"
                       shadow="false" />
                <Spacer h="4" />
                <Label id="detail_description"
                       text="Description"
                       color="#DDDDDD"
                       shadow="false" />
            </ScrollView>
        </Row>
        <Row id="footer"
             w="100%"
             h="26"
             padding="0 8 6 8"
             align="center">
            <Spacer flex="1" />
            <Button id="done"
                    w="80"
                    h="18"
                    text="@Strings.screen.done"
                    bg="#FF555555"
                    color="#FFFFFF"
                    on_click="done" />
        </Row>
    </Column>
</Screen>
