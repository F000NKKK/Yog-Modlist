<?xml version="1.0" encoding="utf-8"?>
<!-- The mod browser. Code-behind: mod_list.rs (rows of the list are added there at runtime). -->
<Screen id="yog-modlist:mod_list"
        width="400"
        height="224"
        anchor="center"
        bg="#E0101010">
    <Row id="header"
         x="0"
         y="0"
         w="400"
         h="20"
         padding="0 8"
         align="center"
         bg="#FF222222">
        <Label id="title"
               text="Yog Mods"
               color="#FFD700"
               no_wrap="true" />
        <Spacer flex="1" />
        <Label id="mod_count"
               text="0 mods"
               color="#AAAAAA"
               shadow="false"
               no_wrap="true" />
    </Row>
    <Row id="filters"
         x="8"
         y="26"
         w="180"
         h="14"
         gap="3">
        <Button id="filter_all"
                w="58"
                h="14"
                text="All"
                bg="#FF555555"
                color="#FFFFFF"
                on_click="filter_all" />
        <Button id="filter_yog"
                w="58"
                h="14"
                text="Yog"
                bg="#FF333333"
                color="#FFFFFF"
                on_click="filter_yog" />
        <Button id="filter_platform"
                w="58"
                h="14"
                text="Platform"
                bg="#FF333333"
                color="#FFFFFF"
                on_click="filter_platform" />
    </Row>
    <ScrollView id="mod_list"
                x="8"
                y="44"
                w="180"
                h="172"
                gap="2"
                padding="2"
                bg="#88111111" />
    <ScrollView id="details"
                x="194"
                y="26"
                w="198"
                h="190"
                gap="3"
                padding="4 6"
                bg="#88111111">
        <Label id="detail_name" text="Mod Name" color="#FFFFFF" />
        <Label id="detail_version"
               text="v1.0.0"
               color="#AAAAAA"
               shadow="false" />
        <Label id="detail_source"
               text="Yog mod"
               color="#88FF88"
               shadow="false" />
        <Label id="detail_authors"
               text="by Author"
               color="#CCCCCC"
               shadow="false" />
        <Label id="detail_id"
               text="id: mod_id"
               color="#9999BB"
               shadow="false" />
        <Spacer h="4" />
        <Label id="detail_description"
               text="Description"
               color="#DDDDDD"
               shadow="false" />
    </ScrollView>
</Screen>
