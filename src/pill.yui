<Component name="Pill" doc="A small framed tag with a short label." width="40" height="12">
    <Property name="label" type="text" default="Yog" doc="The tag's text"/>
    <Property name="fill" type="color" default="#FF2D4A8A" doc="Background"/>
    <Property name="outline" type="color" default="#FF6F8FD8" doc="Frame color"/>
    <Property name="text_color" type="color" default="#FFFFFFFF" doc="Text color"/>
    <Row bg="{x:Bind outline}" padding="1 1 1 1">
        <Row bg="{x:Bind fill}" padding="1 4 1 4" align="center">
            <Label text="{x:Bind label}" color="{x:Bind text_color}" shadow="false" no_wrap="true"/>
        </Row>
    </Row>
</Component>
